# Kopieren nach /etc/craftpilot-bot.env und ausfüllen. Diese Datei NIE ins Repo committen.
# Copy to /etc/craftpilot-bot.env and fill in. NEVER commit the filled-in file.

# Discord Developer Portal -> Applications -> dein Bot -> Bot -> Reset Token
DISCORD_TOKEN=

# Bug-Foren und ihr GitHub-Repo: Forum-ID=owner/repo, mehrere mit Komma.
# Forum-ID: Rechtsklick auf das Forum -> "Kanal-ID kopieren" (Entwicklermodus muss an sein)
# Ein Forum je Addon:
BUG_FORUMS=111111111111111111=Necrite82/CraftPilot,222222222222222222=Necrite82/GearPilot
# Oder ein gemeinsames Forum ohne festes Repo (ID=), dann entscheidet der Addon-Tag am Post:
# BUG_FORUMS=333333333333333333=

# Optional: Addon-Tags (Tag-Name im Forum=Repo). Ein solcher Tag am Post schlägt das Repo des Forums.
# In einem gemeinsamen Forum Pflicht; fehlt der Tag, fragt der Bot im Thread danach.
REPO_TAGS=CraftPilot=Necrite82/CraftPilot,GearPilot=Necrite82/GearPilot

# GitHub Fine-grained token: Repos CraftPilot und GearPilot, Berechtigung "Issues: Read and write"
GITHUB_TOKEN=

# Alte Einstellung (ein Forum, ein Repo) funktioniert weiter:
# BUG_FORUM_ID=
# GITHUB_REPO=Necrite82/CraftPilot

# Tag-Namen genau wie im Discord-Forum
CONFIRMED_TAG=Bestätigt
FIXED_TAG=Behoben / Fixed

# Optional
ISSUE_LABELS=bug
POLL_SECONDS=300
STATE_FILE=/var/lib/craftpilot-bot/state.json
LOG_LEVEL=INFO
